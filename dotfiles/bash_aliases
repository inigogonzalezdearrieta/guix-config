# Standard aliases:
alias la='ls -A'
alias lrt='ls -lrt'
alias lrta='ls -lrtA'
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -p'

# Emacs aliases:
alias vi='emacs -nw'

# Guix aliases:
alias shell='guix shell'
alias exportmanifest='guix package --export-manifest'
alias exportchannels='guix describe -f channels'
